#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Set 0 : UBO camera
layout(set = 0, binding = 0) uniform global_uniform_object {
    mat4 view;
    mat4 projection;
    float time;
} global_ubo;

layout(set = 0, binding = 1) uniform texture2D hzbTexture;
layout(set = 0, binding = 2) uniform sampler hzbSampler;

// Set 1 : buffers
struct ChunkCullData {
    vec4 aabbMin;
    vec4 aabbMax;
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
    uint padding;
};

struct DrawIndirectCommand {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};

layout(set = 1, binding = 0, std430) readonly buffer ChunkCullDataBuffer {
    ChunkCullData chunks[];
};

layout(set = 1, binding = 1, std430) writeonly buffer CulledIndirectBuffer {
    DrawIndirectCommand culledCommands[];
};

layout(set = 1, binding = 2, std430) buffer CulledDrawCountBuffer {
    uint culledCount;
};

layout(push_constant) uniform PushConstants {
    uint chunkCount;
} pc;

void extract_frustum_planes(mat4 vp, out vec4 planes[6]) {
    planes[0] = vec4(vp[0][3] + vp[0][0], vp[1][3] + vp[1][0], vp[2][3] + vp[2][0], vp[3][3] + vp[3][0]); // left
    planes[1] = vec4(vp[0][3] - vp[0][0], vp[1][3] - vp[1][0], vp[2][3] - vp[2][0], vp[3][3] - vp[3][0]); // right
    planes[2] = vec4(vp[0][3] + vp[0][1], vp[1][3] + vp[1][1], vp[2][3] + vp[2][1], vp[3][3] + vp[3][1]); // bottom
    planes[3] = vec4(vp[0][3] - vp[0][1], vp[1][3] - vp[1][1], vp[2][3] - vp[2][1], vp[3][3] - vp[3][1]); // top
    planes[4] = vec4(vp[0][3] + vp[0][2], vp[1][3] + vp[1][2], vp[2][3] + vp[2][2], vp[3][3] + vp[3][2]); // near
    planes[5] = vec4(vp[0][3] - vp[0][2], vp[1][3] - vp[1][2], vp[2][3] - vp[2][2], vp[3][3] - vp[3][2]); // far
}

bool is_aabb_visible(vec3 aabbMin, vec3 aabbMax, vec4 planes[6]) {
    for (int i = 0; i < 6; i++) {
        vec3 n = planes[i].xyz;
        vec3 pVertex = vec3(
        n.x >= 0.0 ? aabbMax.x : aabbMin.x,
        n.y >= 0.0 ? aabbMax.y : aabbMin.y,
        n.z >= 0.0 ? aabbMax.z : aabbMin.z
        );
        if (dot(n, pVertex) + planes[i].w < 0.0) {
            return false;
        }
    }
    return true;
}

bool is_occluded_by_hzb(vec3 aabbMin, vec3 aabbMax, mat4 vp) {
    const vec3 corners[8] = vec3[8](
        vec3(aabbMin.x, aabbMin.y, aabbMin.z),
        vec3(aabbMax.x, aabbMin.y, aabbMin.z),
        vec3(aabbMin.x, aabbMax.y, aabbMin.z),
        vec3(aabbMax.x, aabbMax.y, aabbMin.z),
        vec3(aabbMin.x, aabbMin.y, aabbMax.z),
        vec3(aabbMax.x, aabbMin.y, aabbMax.z),
        vec3(aabbMin.x, aabbMax.y, aabbMax.z),
        vec3(aabbMax.x, aabbMax.y, aabbMax.z)
    );

    vec2 uvMin = vec2(1.0);
    vec2 uvMax = vec2(0.0);
    float depthMin = 1.0;

    for (int i = 0; i < 8; i++) {
        vec4 clip = vp * vec4(corners[i], 1.0);
        if (clip.w <= 0.0) return false; // near plane, consider visible to avoid artifacts

        vec3 ndc = clip.xyz / clip.w;
        vec2 uv = clamp(ndc.xy * 0.5 + 0.5, vec2(0.0), vec2(1.0));
        uvMin = min(uvMin, uv);
        uvMax = max(uvMax, uv);
        depthMin = min(depthMin, ndc.z);
    }

    vec2 rectSize = (uvMax - uvMin) * vec2(textureSize(sampler2D(hzbTexture, hzbSampler), 0));
    float mip = ceil(log2(max(rectSize.x, rectSize.y) * 0.5 + 0.001));
    mip = clamp(mip, 0.0, float(textureQueryLevels(sampler2D(hzbTexture, hzbSampler))) - 1.0);

    float h00 = textureLod(sampler2D(hzbTexture, hzbSampler), uvMin, mip).r;
    float h10 = textureLod(sampler2D(hzbTexture, hzbSampler), vec2(uvMax.x, uvMin.y), mip).r;
    float h01 = textureLod(sampler2D(hzbTexture, hzbSampler), vec2(uvMin.x, uvMax.y), mip).r;
    float h11 = textureLod(sampler2D(hzbTexture, hzbSampler), uvMax, mip).r;
    float hzbDepth = max(max(h00, h10), max(h01, h11));

    return depthMin > hzbDepth + 0.001;
}


void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.chunkCount) return;

    ChunkCullData chunk = chunks[idx];

    // Nothing to draw, skip
    if (chunk.instanceCount == 0) return;

    mat4 vp = global_ubo.projection * global_ubo.view;
    vec4 planes[6];
    extract_frustum_planes(vp, planes);

    if (!is_aabb_visible(chunk.aabbMin.xyz, chunk.aabbMax.xyz, planes)) return;
    if (is_occluded_by_hzb(chunk.aabbMin.xyz, chunk.aabbMax.xyz, vp)) return;



    // Increment the count of visible chunks and write the indirect draw command
    uint outIdx = atomicAdd(culledCount, 1);

    culledCommands[outIdx] = DrawIndirectCommand(
        chunk.vertexCount,
        chunk.instanceCount,
        chunk.firstVertex,
        chunk.firstInstance
    );
}

