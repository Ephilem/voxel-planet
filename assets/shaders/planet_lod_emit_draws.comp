#version 450

// Turns the render queue produced by the traversal into indirect draw commands.
//
// The draw itself is unchanged from the pre LOD path: the same greedy meshed faces, the same
// arguments already stored per draw slot in the chunk cull data buffer. All this pass does is
// choose which of those commands get issued this frame, and compact them so the draw only walks
// what is actually visible.
//
// The dispatch covers the whole queue capacity, since the visible count only exists on the GPU.
// Threads past that count return immediately.

#include "planet_lod_node.glsl"
#include "planet_lod_counters.glsl"

#define LOCAL_SIZE 64

layout (local_size_x = LOCAL_SIZE, local_size_y = 1, local_size_z = 1) in;

layout (set = 0, binding = 0, std430) readonly buffer NodeBuffer {
    LodNode nodes[];
};

layout (set = 0, binding = 1, std430) readonly buffer CounterBuffer {
    uint counters[];
};

layout (set = 0, binding = 2, std430) readonly buffer RenderQueueBuffer {
    uint renderQueue[];
};

// Mirror of VoxelChunkCullData in VoxelBuffer.h, indexed by draw slot.
struct ChunkCullData {
    vec4 aabbMin;
    vec4 aabbMax;
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
    uint padding;
};

layout (set = 0, binding = 3, std430) readonly buffer ChunkCullDataBuffer {
    ChunkCullData chunks[];
};

struct DrawIndirectCommand {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
};

layout (set = 0, binding = 4, std430) writeonly buffer CulledIndirectBuffer {
    DrawIndirectCommand culledCommands[];
};

layout (set = 0, binding = 5, std430) buffer CulledDrawCountBuffer {
    uint culledCount;
};

void main() {
    // The traversal keeps incrementing the counter past the capacity when the queue overflows, so
    // it cannot be trusted as a bound on its own: entries past the capacity were never written
    // and still hold whatever the previous frame left there.
    //
    // The dispatch is sized to cover exactly the queue capacity, so the thread count is that
    // capacity. Deriving it here rather than repeating the number keeps the one definition of it
    // on the C++ side, where the buffer is actually allocated.
    uint capacity = gl_NumWorkGroups.x * LOCAL_SIZE;
    uint renderCount = min(counters[LOD_COUNTER_RENDER], capacity);
    if (gl_GlobalInvocationID.x >= renderCount) return;

    LodNode node = nodes[renderQueue[gl_GlobalInvocationID.x]];
    uint meshId = node_mesh_id(node);
    if (meshId == NODE_INVALID_MESH) return;

    ChunkCullData chunk = chunks[meshId];
    if (chunk.instanceCount == 0u) return;

    // firstInstance carries the draw slot, which is what the vertex shader uses to look up its
    // chunk in the OUB, so copying the arguments verbatim keeps the draw semantics identical to
    // the previous path.
    uint slot = atomicAdd(culledCount, 1u);
    culledCommands[slot] = DrawIndirectCommand(
        chunk.vertexCount,
        chunk.instanceCount,
        chunk.firstVertex,
        chunk.firstInstance);
}
