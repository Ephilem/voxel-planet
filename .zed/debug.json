// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Debug VoxelPlanet",
    "adapter": "GDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/build/debug/VoxelPlanet",
    "cwd": "$ZED_WORKTREE_ROOT/build/debug",
    "console": "integratedTerminal",
    "env": {
      "WAYLAND_DISPLAY": "wayland-0",
      "XDG_RUNTIME_DIR": "/run/user/1000"
    },
    "build": {
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "--parallel"],
    },
  },
  {
    "label": "Debug VoxelPlanet (validation layers)",
    "adapter": "GDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/build/debug/VoxelPlanet",
    "cwd": "$ZED_WORKTREE_ROOT/build/debug",
    "console": "integratedTerminal",
    "env": {
      "VK_INSTANCE_LAYERS": "VK_LAYER_KHRONOS_validation",
      "VK_LAYER_ENABLES": "VK_VALIDATION_FEATURE_ENABLE_BEST_PRACTICES_EXT",
      "WAYLAND_DISPLAY": "wayland-0",
      "XDG_RUNTIME_DIR": "/run/user/1000"
    },
  },
]
